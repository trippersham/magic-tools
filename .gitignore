.ruff_cache

# Secrets: real env files are never committed
.env
**/.env
# ...but the committed example placeholder must be tracked
!.env.example
!**/.env.example

# Node dependencies (required at runtime; install via `npm install`)
node_modules/
**/node_modules/

# Build artifacts (regenerate via `npm run build`)
dist/
**/dist/

# Runtime caches (regenerated on demand; never source)
spoiler_cache.db
**/spoiler_cache.db
**/*.pyc
**/__pycache__/
