#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["make-magic-pipeline"]
# [tool.uv]
# exclude-newer = "2026-06-08T00:00:00Z"
# [tool.uv.sources]
# make-magic-pipeline = { path = "../pipeline", editable = true }
# ///
"""Executable entry for the AI-vs-AI `simulate` CLI (headless MTG Forge).

House convention (raelabs plugins): a plugin-invoked CLI that depends on a local
package is a PEP-723 script that pins that package via ``[tool.uv.sources]`` as an
editable path dep and is invoked DIRECTLY — no ``python -m``, no console-script
install step. ``uv run --script`` resolves the editable ``make-magic-pipeline``
dependency (relative to this file's dir) on each invocation. The dispatcher logic
lives in ``pipeline.sim.run`` (kept importable so the test-suite drives it).

Forge/Java auto-resolve via an override-first ladder; point at a pre-provisioned
install with ``MAKE_MAGIC_FORGE_HOME`` (+ ``MAKE_MAGIC_JAVA``). Deck references
resolve as a ``.dck`` path or an Airtable deck name (the collection backend
auto-resolves; override with ``MAKE_MAGIC_BACKEND=local|airtable``). Usage:
    ${CLAUDE_PLUGIN_ROOT}/scripts/simulate <verb> [args...]

`doctor` and `gauntlet show` run offline (no game JVM); `match` / `deck` / `ab`
spawn real Forge.
"""

import sys

from pipeline.sim.run import main

if __name__ == '__main__':
    main(sys.argv[1:])
