diff --git a/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/MulliganRegistry.java b/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/MulliganRegistry.java
