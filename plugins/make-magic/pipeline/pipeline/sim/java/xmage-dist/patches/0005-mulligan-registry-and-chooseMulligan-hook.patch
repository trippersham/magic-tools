+++ b/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/MulliganRegistry.java
@@ -0,0 +1,32 @@
+package mage.player.ai.score;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * In-search driver hook M registry (sibling of {@link DriverBonus} / {@link MacroRegistry} /
+ * {@link SelectionRegistry}): a per-playerId {@link MulliganSteer}. Keyed by the STABLE
+ * playerId UUID so a steer registered for the real PlayerA decides ONLY that seat's opening
+ * hand, and is a strict no-op for any other seat (per-playerId isolation = the
+ * intelligence-preserving property: an unregistered seat mulligans as pure CP7).
+ */
+public final class MulliganRegistry {
+
+    private static final Map<UUID, MulliganSteer> REGISTRY = new ConcurrentHashMap<>();
+
+    public static void register(UUID playerId, MulliganSteer steer) {
+        REGISTRY.put(playerId, steer);
+    }
+
+    public static void clear(UUID playerId) {
+        REGISTRY.remove(playerId);
+    }
+
+    public static MulliganSteer get(UUID playerId) {
+        return REGISTRY.get(playerId);
+    }
+
+    private MulliganRegistry() {
+    }
+}
diff --git a/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/MulliganSteer.java b/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/MulliganSteer.java
new file mode 100644
