--- /dev/null
+++ b/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/MulliganSteer.java
@@ -0,0 +1,28 @@
+package mage.player.ai.score;
+
+import mage.game.Game;
+
+import java.util.UUID;
+
+/**
+ * In-search driver hook M (mulligan): the per-deck opening-hand keep/ship decision — the
+ * genuine 5th dimension of the quad, alongside {@link DriverBonus} (Φ), {@link ComboMacro}
+ * (P + macro) and {@link SelectionSteer} (S).
+ *
+ * <p>Consulted ONCE by {@code ComputerPlayer.chooseMulligan} on the REAL pre-game decision
+ * (never on a nested search copy — {@code chooseMulligan} guards on {@code !game.isSimulation()}),
+ * keyed by the STABLE playerId. When a steer is registered for the acting seat it decides
+ * keep-vs-ship for THIS opening hand; a strict no-op (unregistered) leaves the seat playing
+ * pure CP7's land-count heuristic (the intelligence-preserving property).</p>
+ *
+ * <p>v1 scope is the KEEP/SHIP boolean only. WHICH cards to bottom (London) stays with CP —
+ * deferred as a follow-up (mirror the {@code SelectionSteer} shape over the bottoming choice).</p>
+ */
+public interface MulliganSteer {
+
+    /**
+     * @return {@code true} to SHIP this opening hand (take a mulligan), {@code false} to KEEP.
+     *         Read the hand via {@code game.getPlayer(playerId).getHand()}.
+     */
+    boolean shipHand(Game game, UUID playerId);
+}
