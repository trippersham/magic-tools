+package mage.player.ai.score;
+
+import mage.game.Game;
+
+import java.util.UUID;
+
+/**
+ * In-search driver hook B: a per-deck deterministic-execution macro.
+ *
+ * <p>A {@code ComboMacro} encodes ONE thing: the deck's deterministic win sequence. It is
+ * consulted by the search's candidate-action generation (ComputerPlayer6.simulatePriority)
+ * at EVERY node and by the real player's action commit (ComputerPlayer6.act), keyed by the
+ * STABLE playerId (invariant across createSimulationForAI copies + the SP2 swap). When
+ * {@link #applicable} holds for the acting player, the search evaluates firing the macro as
+ * a sibling candidate (its terminal scores WIN_GAME_SCORE), so minimax reasons about firing
+ * vs holding with full lookahead; when it holds on the real game, {@link #apply} drives the
+ * kill on the real state.</p>
+ *
+ * <p>{@link #apply} must be BOUNDED and must NEVER call {@code priority()} / the turn loop on
+ * the game it is handed (probeWins discipline): drive it only with explicit state moves /
+ * activateAbility + applyEffects + a capped stack resolve.</p>
+ */
+public interface ComboMacro {
+
+    /** Bound on any hand-driven resolve inside {@link #apply} (probeWins discipline). */
+    int PROBE_MAX_STEPS = 128;
+
+    /** Precondition P: the deterministic win is executable for {@code playerId} in this state. */
+    boolean applicable(Game game, UUID playerId);
+
+    /** Drive the deterministic win sequence for {@code playerId} on {@code game} (bounded). */
+    void apply(Game game, UUID playerId);
+}
diff --git a/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/DriverBonus.java b/Mage.Server.Plugins/Mage.Player.AI/src/main/java/mage/player/ai/score/DriverBonus.java
