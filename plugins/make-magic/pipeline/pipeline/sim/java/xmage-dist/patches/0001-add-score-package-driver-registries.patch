+package mage.player.ai.score;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * In-search driver hook B registry (sibling of {@link DriverBonus}): a per-playerId
+ * {@link ComboMacro}. Keyed by the STABLE playerId UUID so a macro registered for the real
+ * PlayerA is consulted at every search node for that seat AND on the real player's action
+ * commit, and is a strict no-op for any other seat (per-playerId isolation = the
+ * intelligence-preserving property: an unregistered seat plays as pure CP7).
+ */
+public final class MacroRegistry {
+
+    private static final Map<UUID, ComboMacro> REGISTRY = new ConcurrentHashMap<>();
+
+    public static void register(UUID playerId, ComboMacro macro) {
+        REGISTRY.put(playerId, macro);
+    }
+
+    public static void clear(UUID playerId) {
+        REGISTRY.remove(playerId);
+    }
+
+    public static ComboMacro get(UUID playerId) {
+        return REGISTRY.get(playerId);
+    }
+
+    private MacroRegistry() {
+    }
+}
