+package mage.player.ai.score;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * In-search driver hook S registry (sibling of {@link MacroRegistry} / {@link DriverBonus}):
+ * a per-playerId {@link SelectionSteer}. Keyed by the STABLE playerId UUID so a steer
+ * registered for the real PlayerA is consulted on that seat's card-choice hooks in BOTH the
+ * real game AND the sim rollouts (the id is invariant across createSimulationForAI copies +
+ * the SP2 swap), and is a strict no-op for any other seat (per-playerId isolation = the
+ * intelligence-preserving property: an unregistered seat picks with pure CP7).
+ */
+public final class SelectionRegistry {
+
+    private static final Map<UUID, SelectionSteer> REGISTRY = new ConcurrentHashMap<>();
+
+    public static void register(UUID playerId, SelectionSteer steer) {
+        REGISTRY.put(playerId, steer);
+    }
+
+    public static void clear(UUID playerId) {
+        REGISTRY.remove(playerId);
+    }
+
+    public static SelectionSteer get(UUID playerId) {
+        return REGISTRY.get(playerId);
+    }
+
+    private SelectionRegistry() {
+    }
+}
