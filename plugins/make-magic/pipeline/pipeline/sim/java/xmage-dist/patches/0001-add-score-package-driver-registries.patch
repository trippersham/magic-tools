@@ -0,0 +1,37 @@
+package mage.player.ai.score;
+
+import mage.game.Game;
+
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.function.ToIntBiFunction;
+
+/**
+ * POC reward-shaping seam: a per-playerId "distance-to-win" bonus folded into the
+ * normal-heuristic leaf score of {@link GameStateEvaluator2}. Keyed by the STABLE
+ * playerId UUID (invariant across createSimulationForAI copies + the SP2 swap), so a
+ * bonus registered for the real PlayerA reaches every PlayerA leaf in the real search
+ * AND the nested rollouts. Bounded by the caller (recommend |bonus| &lt;&lt; WIN_GAME_SCORE).
+ * Deterministic pure function of (game, playerId) is required to keep alpha-beta correct.
+ */
+public final class DriverBonus {
+
+    private static final Map<UUID, ToIntBiFunction<Game, UUID>> REGISTRY = new ConcurrentHashMap<>();
+
+    public static void register(UUID playerId, ToIntBiFunction<Game, UUID> fn) {
+        REGISTRY.put(playerId, fn);
+    }
+
+    public static void clear(UUID playerId) {
+        REGISTRY.remove(playerId);
+    }
+
+    public static int evaluate(UUID playerId, Game game) {
+        ToIntBiFunction<Game, UUID> fn = REGISTRY.get(playerId);
+        return fn == null ? 0 : fn.applyAsInt(game, playerId);
+    }
+
+    private DriverBonus() {
+    }
+}
