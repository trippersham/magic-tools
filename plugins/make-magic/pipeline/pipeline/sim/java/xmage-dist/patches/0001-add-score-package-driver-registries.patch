@@ -0,0 +1,37 @@
+package mage.player.ai.score;
+
+import mage.abilities.Ability;
+import mage.cards.Cards;
+import mage.game.Game;
+import mage.target.TargetCard;
+
+import java.util.UUID;
+
+/**
+ * In-search driver hook S (selection steer): a per-deck thin nudge on the REAL-player
+ * card-choice hooks ({@code ComputerPlayer(6).chooseTarget/choose} over {@link Cards} /
+ * {@link TargetCard}) — the choice-points {@link DriverBonus} (leaf eval) and
+ * {@link ComboMacro} (action gen) cannot reach.
+ *
+ * <p>Where Φ gets the deck TO a tutor cast and the macro fires FROM an assembled hand, S
+ * closes the gap between them: when a tutor searches MY library and I am missing a combo
+ * piece, S steers the search's target-pick to the MISSING piece instead of CP7's
+ * first-legal card. It is consulted keyed by the STABLE playerId, so it fires in BOTH the
+ * real game (CP6 seat) AND the nested sim rollouts (SimulatedPlayer2 → ComputerPlayer
+ * seat) — the sim firing is essential: it lets the search MODEL assembly
+ * ("cast tutor → hold both pieces → macro → WIN") and thus VALUE casting the tutor. A
+ * strict no-op for any unregistered seat (intelligence-preserving isolation).</p>
+ */
+public interface SelectionSteer {
+
+    /**
+     * If this steer applies to {@code playerId}'s current card choice, add the steered
+     * target(s) to {@code target} and return {@code true} (the caller then returns without
+     * running CP7's default pick). Otherwise return {@code false} (fall through to CP7).
+     *
+     * @param useAddTarget {@code true} → add via {@code target.addTarget(id, source, game)}
+     *                     (the {@code chooseTarget} path); {@code false} → {@code target.add(id, game)}
+     *                     (the {@code choose} path).
+     */
+    boolean apply(Game game, UUID playerId, Cards cards, TargetCard target, Ability source, boolean useAddTarget);
+}
