  "ranking_only_density": {
    "spell-density": {
      "mechanism": "count cards whose type_line matches Instant or Sorcery",
      "field": "type_line",
      "regex": "\\b(Instant|Sorcery)\\b",
      "threshold_cards": 12,
      "rationale": "spellslinger/magecraft archetypes; the magecraft otag covers only ~31 cards lake-wide so otag-based detection is dead — density over the printed card type is the general mechanism."
    },
    "artifact-density": {
      "mechanism": "count cards whose type_line matches Artifact",
      "field": "type_line",
      "regex": "\\bArtifact\\b",
      "threshold_cards": 12,
      "rationale": "affinity/artifact-matters archetypes; generic over type_line."
    },
    "enchantment-density": {
      "mechanism": "count cards whose type_line matches Enchantment",
      "field": "type_line",
      "regex": "\\bEnchantment\\b",
      "threshold_cards": 12,
      "rationale": "enchantress/enchantments-matter archetypes; generic over type_line."
    },
    "creature-type-density": {
      "mechanism": "max count of any single creature subtype across the deck's creatures (from type_line after the dash)",
      "field": "type_line",
      "threshold_cards": 8,
      "rationale": "generic typal detector: a dominant shared creature subtype, independent of any specific tribe."
    }
  }
}
