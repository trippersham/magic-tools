# DuckDB working database + WAL
data/*.duckdb
data/*.duckdb.wal
data/*.db

# Generated lake layers (fetched/derived, rebuilt on demand; not committed).
# Committed offline snapshots live under data/snapshots/ (NOT ignored).
data/raw/
data/normalized/
data/marts/
!data/snapshots/

# Local hand-editable collection store (per-user working data: decks/inventory/
# chase/trades YAML). Never committed — the tracked sample lives under
# tests/fixtures/collection/. Does NOT touch the committed data/snapshots/.
data/collection/

# Per-user resolver cache (Scryfall name -> Card), rewritten on every get_card.
# Never committed (git churn + stale served-forever entries). Snapshots stay
# tracked (they live under data/snapshots/, guarded above).
data/scryfall_names.json

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
# uv.lock IS committed (reproducible installs; pinned by exclude-newer).
