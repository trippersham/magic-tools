# Airtable Personal Access Token used by the bundled airtable MCP server to
# reach the shared "Magic Inventory" base.
#
# Credential precedence (see .mcp.json):
#   1. An ambient $AIRTABLE_API_KEY in the environment always wins.
#   2. Otherwise, if this file has been copied to `.env` (gitignored), it is
#      sourced and AIRTABLE_API_KEY is read from it.
#
# To use: copy this file to `.env` and set the token below.
AIRTABLE_API_KEY=

# OPTIONAL — instead of pasting a raw token, resolve it from a local secrets
# manager at load time. Example using the 1Password CLI (placeholders only —
# substitute your own account, vault, and item):
# export AIRTABLE_API_KEY="$(op read --account <your-1p-account> 'op://<Vault>/<Item>/credential')"
