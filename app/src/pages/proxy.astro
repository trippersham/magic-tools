---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Proxy Art Picker</title>
  </head>
  <body class="bg-zinc-900 text-zinc-100 min-h-screen">
    <!-- Header bar -->
    <header class="sticky top-0 z-10 bg-zinc-800 border-b border-zinc-700 px-4 py-3">
      <div class="max-w-5xl mx-auto flex flex-wrap items-center gap-3">
        <h1 class="text-lg font-semibold shrink-0">Proxy Art Picker</h1>

        <!-- Search -->
        <div class="flex items-center gap-2 flex-1 min-w-[200px]">
          <input
            id="search-input"
            type="text"
            placeholder="Card name or Scryfall URL..."
            class="flex-1 rounded bg-zinc-700 border border-zinc-600 px-3 py-1.5 text-sm placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <button
            id="btn-add"
            class="rounded bg-blue-600 hover:bg-blue-500 px-3 py-1.5 text-sm font-medium"
          >
            Add
          </button>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-2">
          <button
            id="btn-import"
            class="rounded bg-zinc-700 hover:bg-zinc-600 border border-zinc-600 px-3 py-1.5 text-sm"
          >
            Import
          </button>
          <button
            id="btn-export"
            class="rounded bg-zinc-700 hover:bg-zinc-600 border border-zinc-600 px-3 py-1.5 text-sm"
          >
            Export
          </button>
        </div>

        <!-- Counter + dirty dot -->
        <div class="flex items-center gap-2 text-sm text-zinc-400">
          <span id="counter">0 cards</span>
          <span
            id="dirty-dot"
            class="hidden w-2.5 h-2.5 rounded-full bg-amber-400"
            title="Unexported changes"
          ></span>
        </div>
      </div>
    </header>

    <!-- Card list -->
    <main class="max-w-5xl mx-auto px-4 py-6">
      <div id="card-list"></div>
    </main>

    <!-- Import confirm modal -->
    <dialog id="import-modal" class="bg-zinc-800 text-zinc-100 rounded-lg p-6 max-w-md backdrop:bg-black/50">
      <h2 class="text-lg font-semibold mb-3">Replace current list?</h2>
      <p class="text-sm text-zinc-400 mb-4">
        Importing this file will replace all current cards and selections.
        Unexported changes will be lost.
      </p>
      <div class="flex justify-end gap-3">
        <button id="import-cancel" class="rounded bg-zinc-700 hover:bg-zinc-600 px-3 py-1.5 text-sm">
          Cancel
        </button>
        <button id="import-confirm" class="rounded bg-red-600 hover:bg-red-500 px-3 py-1.5 text-sm font-medium">
          Replace
        </button>
      </div>
    </dialog>

    <!-- Exit / export-first modal -->
    <dialog id="exit-modal" class="bg-zinc-800 text-zinc-100 rounded-lg p-6 max-w-md backdrop:bg-black/50">
      <h2 class="text-lg font-semibold mb-3">Unexported changes</h2>
      <p class="text-sm text-zinc-400 mb-4">
        You have changes that haven't been exported. Export now to save your work.
      </p>
      <div class="flex justify-end gap-3">
        <button id="exit-dismiss" class="rounded bg-zinc-700 hover:bg-zinc-600 px-3 py-1.5 text-sm">
          Dismiss
        </button>
        <button id="exit-export" class="rounded bg-blue-600 hover:bg-blue-500 px-3 py-1.5 text-sm font-medium">
          Export
        </button>
      </div>
    </dialog>

    <script src="../scripts/proxy.ts"></script>
  </body>
</html>
