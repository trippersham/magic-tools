---
import '../styles/global.css';
import Card from '../components/Card.astro';
import MetadataBand from '../components/MetadataBand.astro';
import { toColumns } from '../lib/grouping';
import { nameDiffMap } from '../lib/diff';
import { stackBadge } from '../lib/instances';
import type { EnrichedData, TaggedCard, Membership, EnrichedCard } from '../lib/types';
import enrichedData from '../data/enriched.json';

const data = enrichedData as unknown as EnrichedData;

// v3.2: nameDiffMap is the SOLE source of per-tile membership AND quantity. The
// old binary `dropSet.has(name)` tagging is gone — every consumer (tiles, view
// filtering, metadata) reads the same per-name netting.
const perName = nameDiffMap(data.deck, data.changeset);
const countsFor = (name: string) =>
  perName.get(name) ?? { untouchedQty: 0, droppedQty: 0, addedQty: 0 };

const deckByName = new Map<string, EnrichedCard>(data.deck.map((c) => [c.name, c]));
const addByName = new Map<string, EnrichedCard>(data.adds.map((c) => [c.name, c]));

// The master tile's primary membership label derives from the netted badge kind
// (unchanged→untouched, drop, add). A genuinely mixed name stays a deck resident
// ('untouched') — its amber border comes from the badge kind in Card.astro and
// its per-copy visibility from the u/r/a counts, not from this coarse label.
function primaryLabel(nd: {
  untouchedQty: number;
  droppedQty: number;
  addedQty: number;
}): Membership {
  const kind = stackBadge(nd).kind;
  if (kind === 'drop') return 'drop';
  if (kind === 'add') return 'add';
  return 'untouched';
}

// One master tile per name: deck residents (possibly with drops/adds) plus
// pure-add names. A name in both deck AND adds yields ONE tile (from the deck
// card) carrying addedQty — no double-render.
const masters = [...perName.values()]
  .map((nd) => {
    const base = deckByName.get(nd.name) ?? addByName.get(nd.name);
    if (!base) return null;
    return {
      card: { ...base, membership: primaryLabel(nd) } as TaggedCard,
      u: nd.untouchedQty,
      r: nd.droppedQty,
      a: nd.addedQty,
    };
  })
  .filter((m): m is NonNullable<typeof m> => m !== null);

const considTagged: TaggedCard[] = (data.considerations ?? []).map((c) => ({
  ...c,
  membership: 'consideration' as Membership,
}));

// Superset rendered once (deck + adds); the client script filters per view.
const superset: TaggedCard[] = masters.map((m) => m.card);
const columns = toColumns(superset);
const considColumns = toColumns(considTagged);

// Quantity-correct metadata arrays for the SSR band (qty overrides so a partial
// drop keeps its survivors and an add-to-existing counts once, grown).
const mCurrent: TaggedCard[] = [];
const mProposed: TaggedCard[] = [];
const mAdds: TaggedCard[] = [];
const mDrops: TaggedCard[] = [];
for (const nd of perName.values()) {
  const base = deckByName.get(nd.name) ?? addByName.get(nd.name);
  if (!base) continue;
  const cur = nd.untouchedQty + nd.droppedQty;
  const prop = nd.untouchedQty + nd.addedQty;
  if (cur > 0) mCurrent.push({ ...base, qty: cur, membership: 'untouched' });
  if (prop > 0) mProposed.push({ ...base, qty: prop, membership: 'untouched' });
  if (nd.addedQty > 0) mAdds.push({ ...base, qty: nd.addedQty, membership: 'add' });
  if (nd.droppedQty > 0) mDrops.push({ ...base, qty: nd.droppedQty, membership: 'drop' });
}

const dropCount = masters.filter((m) => m.r > 0).length;
const addCount = masters.filter((m) => m.a > 0).length;

const VIEWS = [
  ['all', 'All'],
  ['current', 'Current'],
  ['proposed', 'Proposed'],
  ['adds', 'Adds'],
  ['drops', 'Drops'],
  ['changes', 'Changes'],
] as const;

const deckName = 'Ardenn + Rográkh';

// Column header counts are quantity-weighted so a basic-land pile (Plains x15)
// counts as 15, not one tile.
const colQty = (cards: TaggedCard[]) => cards.reduce((a, c) => a + (c.qty ?? 1), 0);

// Slim per-card stat data for the client-side live metadata band (recomputed on
// every curation change). ONE entry per name carrying the netted u/r/a counts so
// the band buckets by netted quantities (no double-count for add-to-existing);
// considerations ride along as a disjoint pool.
const cardsData = [
  ...[...perName.values()].map((nd) => {
    const base = deckByName.get(nd.name) ?? addByName.get(nd.name);
    return {
      name: nd.name,
      qty: nd.deckQty || nd.addedQty,
      cmc: base?.cmc ?? 0,
      mana_cost: base?.mana_cost ?? null,
      type_line: base?.type_line ?? '',
      u: nd.untouchedQty,
      r: nd.droppedQty,
      a: nd.addedQty,
      consideration: false,
    };
  }),
  ...considTagged.map((c) => ({
    name: c.name,
    qty: c.qty,
    cmc: c.cmc,
    mana_cost: c.mana_cost ?? null,
    type_line: c.type_line,
    u: 0,
    r: 0,
    a: 0,
    consideration: true,
  })),
];

// Baseline the client store keys off (deck name + hash of this changeset).
const baseline = {
  deckName,
  changeset: {
    adds: data.changeset.adds,
    drops: data.changeset.drops,
    considerations: data.changeset.considerations ?? [],
  },
};
---

<html lang="en" data-active-view="all" data-mode="image" data-density="art">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Deck Diff — {deckName}</title>
  </head>
  <body class="min-h-screen bg-zinc-950 text-zinc-100 antialiased">
    <div class="mx-auto max-w-[1600px] px-4 py-6">
      <header class="mb-4 flex flex-wrap items-center justify-between gap-4">
        <div>
          <h1 class="text-2xl font-bold tracking-tight">{deckName}</h1>
          <p class="text-sm text-zinc-400">
            Proposed refinement — <span class="text-red-400">{dropCount} drops</span> /
            <span class="text-emerald-400">{addCount} adds</span> /
            <span class="text-zinc-300">{considTagged.length} considerations</span>. Hover for
            details; drag a card to re-tag it.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4">
          {/* Group By ▾ — radio Type · Color (v3.3) */}
          <div class="dropdown" data-dropdown="group">
            <button
              type="button"
              class="dropdown-btn"
              data-dropdown-btn
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span data-dropdown-label="group">Group By: Type</span>
            </button>
            <div class="dropdown-panel" data-dropdown-panel hidden role="menu" aria-label="Group by">
              <label class="dd-opt"><input type="radio" name="groupBy" value="type" /> Type</label>
              <label class="dd-opt"><input type="radio" name="groupBy" value="color" /> Color</label>
            </div>
          </div>

          {/* Render ▾ — Mode + (Cards-only) Density / Stacking (v3.3) */}
          <div class="dropdown" data-dropdown="render">
            <button
              type="button"
              class="dropdown-btn"
              data-dropdown-btn
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span data-dropdown-label="render">Render: Cards</span>
              <span class="dd-caret" aria-hidden="true"></span>
            </button>
            <div class="dropdown-panel" data-dropdown-panel hidden role="menu" aria-label="Render">
              <div class="dd-section" role="radiogroup" aria-label="Mode">
                <div class="dd-heading">Mode</div>
                <label class="dd-opt"><input type="radio" name="mode" value="cards" /> Cards</label>
                <label class="dd-opt"><input type="radio" name="mode" value="text" /> Text</label>
              </div>
              <div class="dd-cards-only" data-cards-only>
                <hr class="dd-rule" />
                <div class="dd-section" role="radiogroup" aria-label="Density">
                  <div class="dd-heading">Density</div>
                  <label class="dd-opt"><input type="radio" name="density" value="compact" /> Compact</label>
                  <label class="dd-opt"><input type="radio" name="density" value="art" /> Art</label>
                  <label class="dd-opt"><input type="radio" name="density" value="full" /> Full</label>
                </div>
                <hr class="dd-rule" />
                <label class="dd-opt"><input type="checkbox" name="stackDuplicates" /> Stack Duplicates</label>
                <label class="dd-opt"><input type="checkbox" name="stackBasicLands" /> Stack Basic Lands</label>
              </div>
            </div>
          </div>

          <button type="button" data-export class="action-btn">Export curation</button>
          <button type="button" data-reset class="action-btn action-btn-ghost">Reset to proposed</button>
        </div>
      </header>

      <nav class="segmented mb-4" aria-label="View switcher">
        {
          VIEWS.map(([key, label]) => (
            <button type="button" data-view-btn={key} aria-pressed={key === 'all'} class="seg-btn">
              {label}
            </button>
          ))
        }
      </nav>

      <MetadataBand current={mCurrent} proposed={mProposed} adds={mAdds} drops={mDrops} />

      {/* Image stacks view */}
      <div class="stacks-view flex flex-wrap items-start gap-5">
        {
          columns.map((col) => (
            <section class="column" data-column={col.group}>
              <h2 class="column-title">
                {col.group} <span class="count">{colQty(col.cards)}</span>
              </h2>
              <div class="stack">
                {col.cards.map((card) => (
                  <Card
                    card={card}
                    untouchedQty={countsFor(card.name).untouchedQty}
                    droppedQty={countsFor(card.name).droppedQty}
                    addedQty={countsFor(card.name).addedQty}
                  />
                ))}
              </div>
            </section>
          ))
        }
      </div>

      {/* Considerations — evaluated but not proposed; source pool for drag-to-add. */}
      {
        considTagged.length > 0 && (
          <section class="considerations-section mt-8" data-considerations>
            <h2 class="section-heading">
              Considerations
              <span class="section-sub">owned & evaluated — not proposed</span>
            </h2>
            <div class="stacks-view flex flex-wrap items-start gap-5">
              {considColumns.map((col) => (
                <section class="column" data-column={col.group}>
                  <h2 class="column-title">
                    {col.group} <span class="count">{colQty(col.cards)}</span>
                  </h2>
                  <div class="stack">
                    {col.cards.map((card) => (
                      <Card card={card} />
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </section>
        )
      }

      {/* Text view */}
      <div class="text-view">
        {
          columns.map((col) => (
            <section class="text-column" data-column={col.group}>
              <h2 class="column-title">
                {col.group} <span class="count">{colQty(col.cards)}</span>
              </h2>
              <ul>
                {col.cards.map((card) => (
                  <li class={`text-row ${card.membership}`} data-membership={card.membership}>
                    <span class="tr-qty">{card.qty > 1 ? `${card.qty}×` : ''}</span>
                    <span class="tr-name">{card.name}</span>
                    <span class="tr-cost">{card.mana_cost ?? ''}</span>
                    <span class="tr-cmc">{card.cmc}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>

    {/* Floating info pane (v2.3) — one at a time, positioned by the client. */}
    <div id="info-pane" hidden role="tooltip">
      <div class="ip-reason"></div>
      <div class="ip-cost">
        <span class="ip-mana"></span>
        <span class="ip-price"></span>
      </div>
    </div>

    {/* Drag donut (v2.6) — rendered/positioned by drag.ts on drag start. */}
    <div id="drag-donut" hidden aria-hidden="true"></div>

    {/* Fan layer (v4.4) — a stacked master's copies spread here when unstacked. */}
    <div id="fan-layer" hidden></div>

    {/* Note input popover (v2.6 annotate) */}
    <div id="note-popover" hidden>
      <label class="np-label">Note</label>
      <textarea class="np-input" rows="3" placeholder="Add a note or question…"></textarea>
      <div class="np-actions">
        <button type="button" class="np-save action-btn">Save</button>
        <button type="button" class="np-cancel action-btn action-btn-ghost">Cancel</button>
      </div>
    </div>

    <script type="application/json" id="baseline-data" set:html={JSON.stringify(baseline)}></script>
    <script type="application/json" id="cards-data" set:html={JSON.stringify(cardsData)}></script>

    <script src="../scripts/main.ts"></script>
  </body>
</html>
